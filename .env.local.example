# Google Sheets Integration — Credenciais
# Copie este arquivo para .env.local e preencha com suas credenciais

# ID da planilha no Google Sheets
# Exemplo: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms/edit
# O ID é a parte entre /d/ e /edit
GOOGLE_SHEETS_ID=sua_planilha_id_aqui

# Email da Service Account (do arquivo JSON baixado)
GOOGLE_SERVICE_ACCOUNT_EMAIL=financeiro-os-service@seu-projeto.iam.gserviceaccount.com

# Chave privada da Service Account (do arquivo JSON baixado, campo "private_key")
# Mantenha as aspas e preserve os \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
